{
  "manifest_version": 3,
  "name": "Codex + Claude Usage Sidebar",
  "version": "1.1.0",
  "description": "Shows Codex and Claude 5-hour/weekly usage inside their left sidebars and refreshes every 5 minutes.",
  "icons": {
    "48": "assets/icons/icon-48.png",
    "96": "assets/icons/icon-96.png"
  },
  "permissions": [
    "alarms",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://claude.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Codex + Claude Usage Sidebar",
    "default_icon": {
      "48": "assets/icons/icon-48.png",
      "96": "assets/icons/icon-96.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
