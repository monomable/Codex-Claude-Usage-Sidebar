{
  "manifest_version": 3,
  "name": "Codex + Claude Usage Sidebar",
  "version": "1.1.0",
  "description": "Shows Codex and Claude 5-hour/weekly usage inside their left sidebars and refreshes every 5 minutes.",
  "permissions": [
    "alarms",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://claude.ai/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "codex-usage-sidebar@local",
      "strict_min_version": "128.0"
    }
  }
}
